generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  member
  account
}


enum ProjectStatus {
  draft
  active
  on_hold
  completed
  archived
}

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
  critical
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(member)
  isActive      Boolean  @default(true) @map("is_active")
  apiKey        String?  @unique @map("api_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  refreshTokens   RefreshToken[]
  createdProjects Project[]        @relation("ProjectCreatedBy")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreatedBy")
  notes           Note[]
  timeEntries     TimeEntry[]
  documents       Document[]
  attendanceEntries Attendance[]
  leaves          Leave[]
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  spentTransactions   Transaction[] @relation("TransactionSpentBy")
  activities          Activity[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(draft)
  category    String        @default("client")
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  createdBy   String        @map("created_by") @db.Uuid
  githubRepo  String?       @map("github_repo")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt      @map("updated_at")

  creator   User            @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  members   ProjectMember[]
  tasks     Task[]
  documents Document[]
  commits   Commit[]
  transactions Transaction[] @relation("ProjectTransactions")
  activities   Activity[]

  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  assignedTo  String?      @map("assigned_to") @db.Uuid
  dueDate     DateTime?    @map("due_date")
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt      @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator     User        @relation("TaskCreatedBy", fields: [createdBy], references: [id])
  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  content   String
  color     String   @default("neutral")
  category  String   @default("work")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

model TimeEntry {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  durationMinutes Int?      @map("duration_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  filePath   String   @map("file_path")
  mimeType   String?  @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  category   String?
  projectId  String?  @map("project_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@map("documents")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Commit {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  sha         String
  message     String
  authorName  String   @map("author_name")
  authorEmail String   @map("author_email")
  url         String
  committedAt DateTime @map("committed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha])
  @@index([projectId])
  @@index([committedAt])
  @@map("commits")
}

model Attendance {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  checkIn   DateTime  @map("check_in")
  checkOut  DateTime? @map("check_out")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attendance")
}

enum LeaveType {
  sick
  casual
  annual
  unpaid
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model Leave {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  type        LeaveType   @default(casual)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  reason      String?
  status      LeaveStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("leaves")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("holidays")
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum TransactionType {
  deposit
  withdrawal
  transfer
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  code        String      @unique
  type        AccountType
  description String?
  balance     Float       @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  transactions   Transaction[] @relation("AccountTransactions")
  toTransactions Transaction[] @relation("TransferToAccount")

  @@map("accounts")
}

model Transaction {
  id           String          @id @default(uuid()) @db.Uuid
  accountId    String          @map("account_id") @db.Uuid
  toAccountId  String?         @map("to_account_id") @db.Uuid
  type         TransactionType
  amount       Float
  date         DateTime
  description  String?
  reference    String?
  category     String?
  spentById    String?         @map("spent_by_id") @db.Uuid
  projectId    String?         @map("project_id") @db.Uuid
  createdById  String          @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt      @map("updated_at")

  account      Account         @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount    Account?        @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  spentBy      User?           @relation("TransactionSpentBy", fields: [spentById], references: [id], onDelete: SetNull)
  project      Project?        @relation("ProjectTransactions", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([toAccountId])
  @@index([date])
  @@index([spentById])
  @@index([projectId])
  @@map("transactions")
}

model QubartechTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  position  String
  image     String?
  facebook  String?
  linkedin  String?
  github    String?
  portfolio String?
  x         String?
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("qubartech_team_members")
}

model QubartechProduct {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  category      String?
  description   String?
  features      String?
  icon          String?
  color         String?
  tags          String?
  image         String?
  link          String?
  status        String   @default("live")
  privacyPolicy String?  @map("privacy_policy") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  hasProjectManagement Boolean  @default(true) @map("has_project_management")
  hasPrivacy            Boolean  @default(true) @map("has_privacy")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@map("qubartech_products")
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // "attendance", "project", "task", "note", "document", "commit", "transaction"
  action      String   // "create", "update", "delete", "check_in", "check_out", "status_change", etc.
  userId      String?  @map("user_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  description String
  metadata    Json?    // Optional JSON for extra details
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("activities")
}




