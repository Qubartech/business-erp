# PostgreSQL connection string (hosted Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# JWT secrets — generate with: openssl rand -hex 64
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Supabase Storage (for document uploads)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# CORS — comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:8080
