{
  "name": "qubartech-erp-root",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "yarn --cwd web dev",
    "build": "yarn --cwd web build",
    "start": "yarn --cwd web start",
    "prisma:generate": "yarn --cwd web prisma:generate",
    "prisma:migrate": "yarn --cwd web prisma:migrate",
    "prisma:deploy": "yarn --cwd web prisma:deploy",
    "seed": "yarn --cwd web seed"
  }
}
